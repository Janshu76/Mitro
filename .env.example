# AI-assisted Phase 1 obligation drafting
# Ollama keeps clause text on this computer. Start Ollama and pull a model first,
# for example: ollama pull qwen2.5
MITRO_LLM_PROVIDER=ollama
MITRO_LLM_BASE_URL=http://127.0.0.1:11434/v1
MITRO_LLM_API_KEY=
MITRO_LLM_MODEL=qwen2.5
MITRO_LLM_TIMEOUT_SECONDS=90

# To use Sarvam instead, set provider=sarvam, paste a Sarvam API key, and choose
# a model enabled for your account. The default base URL is https://api.sarvam.ai/v1.
# MITRO_LLM_PROVIDER=sarvam
# MITRO_LLM_BASE_URL=https://api.sarvam.ai/v1
# MITRO_LLM_API_KEY=replace-with-your-own-key
# MITRO_LLM_MODEL=sarvam-105b
# MITRO_LLM_API_VERSION=1

# Allow Mitro to inspect additional local repository roots (separate with ; on Windows).
# Leave unset to allow only folders inside the Mitro project.
# MITRO_ALLOWED_REPO_ROOTS=C:\Projects;D:\Work

# Optional PostgreSQL database
# MITRO_DATABASE_URL=postgresql+psycopg://mitro:password@localhost/mitro
